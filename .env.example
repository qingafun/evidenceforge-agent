# Default demo mode requires no API key, GPU, Docker or model downloads.
EF_DATA_DIR=data
EF_MODEL=your-model-name
EF_BASE_URL=https://api.openai.com/v1
EF_API_KEY=
# Optional web search; without this, research uses only the local knowledge base.
EF_TAVILY_API_KEY=
EF_MAX_TOKENS=64000
# Initial output allowance per model request; truncated responses retry once with
# a larger allowance, always within EF_MAX_TOKENS (the cumulative run budget).
EF_MAX_OUTPUT_TOKENS=4096
EF_REQUEST_TIMEOUT=60
# Local Ollama example (requires an installed tool-calling capable model):
# EF_BASE_URL=http://localhost:11434/v1
# EF_API_KEY=ollama
# EF_MODEL=your-installed-model
